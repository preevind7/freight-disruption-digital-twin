# Copy to .env and adjust if needed.
# Frontend origins allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080,https://preevind7.github.io
# Optional custom folders
# DATASETS_DIR=datasets
# MODELS_DIR=trained_models
# REPORTS_DIR=reports

# Login tokens. Generate with: python -m app.manage_users secret
JWT_SECRET=
# Minutes a login stays valid (default 480 = 8 hours)
TOKEN_EXPIRE_MINUTES=480
# Lock an account for LOCKOUT_MINUTES after MAX_FAILED_LOGINS wrong passwords
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=5
# USERS_FILE=users.json

# Allow sign-up from the login page (true/false)
ALLOW_REGISTRATION=true

# Corridor forecast: get recent rainfall from Open-Meteo for current dates (true/false)
LIVE_WEATHER=true
LIVE_WEATHER_TIMEOUT=4
FORECAST_CACHE_MINUTES=30

# ---------------- AI assistant (real LLM) ----------------
# Choose ONE provider: gemini | groq | anthropic | openai | ollama | none
#   gemini : free tier, key from Google AI Studio      (default model gemini-3.8-flash)
#   groq   : free tier, key from console.groq.com/keys (default model openai/gpt-oss-120b)
#   ollama : free, runs on your PC, no key             (default model llama3.2)
#   anthropic / openai : paid
LLM_PROVIDER=none
LLM_API_KEY=
# Leave empty to use the provider's default model / address
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT=60
LLM_MAX_TOKENS=1500
# Optional backup provider, used automatically when the main one is busy (HTTP 503), too slow or over quota.
# e.g. main = gemini, backup = groq (free key from console.groq.com/keys)
LLM_FALLBACK_PROVIDER=none
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_PRIMARY_TIMEOUT_WITH_FALLBACK=25
ASSISTANT_REQUESTS_PER_MINUTE=10

# ---- Live traffic (TomTom Traffic Flow API, free key from developer.tomtom.com, no card) ----
# Keep the key only here. It is used by the backend and never sent to the browser.
TOMTOM_API_KEY=
LIVE_TRAFFIC=true
TRAFFIC_CACHE_MINUTES=30
TRAFFIC_DAILY_BUDGET=2300
